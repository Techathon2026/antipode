<Slide style={{ width: 1280, height: 720, background: '#F7F5F0', padding: '0px' }}>
    <Box style={{ position: 'relative', width: 1280, height: 720, padding: '20px 60px' }}>

        {/* A 标题块 */}
        <Box style={{ height: 100, flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: 13, letterSpacing: 3, color: '#2F5BE4', marginBottom: 8 }}>0 1 · 问 题</Text>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#14161A', lineHeight: 1.25 }}>推荐越准，你越窄</Text>
        </Box>

        {/* B 内容区：巨型引言 + 三行事实 */}
        <Box style={{ height: 540 }}>
            <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#14161A', lineHeight: 1.45 }}>
                所有产品都在回答<br />
                <span style={{ color: '#2F5BE4' }}>「你还想要什么」</span>
            </Text>
            <Text style={{ fontSize: 40, fontWeight: 'bold', color: 'rgba(20,22,26,0.38)', lineHeight: 1.45, marginTop: 6 }}>
                没有人回答「你漏了什么」
            </Text>

            <Box style={{ marginTop: 44, borderTop: '1px solid rgba(20,22,26,0.10)' }} />

            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingTop: 22, paddingBottom: 22, borderBottom: '1px solid rgba(20,22,26,0.10)' }}>
                <Text style={{ width: 64, fontSize: 20, fontWeight: 'bold', color: '#C2410C' }}>01</Text>
                <Text style={{ flex: 1, fontSize: 21, color: '#14161A', lineHeight: 1.55 }}>
                    平台的优化目标是<span style={{ fontWeight: 'bold' }}>停留时长</span>，不是你的判断质量。
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingTop: 22, paddingBottom: 22, borderBottom: '1px solid rgba(20,22,26,0.10)' }}>
                <Text style={{ width: 64, fontSize: 20, fontWeight: 'bold', color: '#C2410C' }}>02</Text>
                <Text style={{ flex: 1, fontSize: 21, color: '#14161A', lineHeight: 1.55 }}>
                    你关注微服务，它就只给你微服务；你相信 TDD，它就只给你 TDD 的成功案例。
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', paddingTop: 22 }}>
                <Text style={{ width: 64, fontSize: 20, fontWeight: 'bold', color: '#C2410C' }}>03</Text>
                <Text style={{ flex: 1, fontSize: 21, color: '#14161A', lineHeight: 1.55 }}>
                    真正的盲区不会自己出现 —— 因为它不在你的兴趣画像里。
                </Text>
            </Box>
        </Box>

        {/* C 页脚 */}
        <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 20, flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 13, color: 'rgba(20,22,26,0.40)' }}>ANTIPODE · TECHATHON 2026</Text>
            <Text style={{ fontSize: 13, color: 'rgba(20,22,26,0.40)' }}>02 / 09</Text>
        </Box>
    </Box>
</Slide>
