<Slide style={{ width: 1280, height: 720, background: '#14161A', padding: '0px' }}>
    <Box style={{ position: 'relative', width: 1280, height: 720, padding: '20px 60px' }}>

        {/* A 标题块 */}
        <Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Box style={{ flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 13, letterSpacing: 3, color: 'rgba(247,245,240,0.45)', marginBottom: 8 }}>0 3 · 产 品 形 态</Text>
                <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.25 }}>一个库，两栏</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 15, color: 'rgba(247,245,240,0.55)' }}>反推荐</Text>
                <Box style={{ width: 56, height: 30, borderRadius: 15, background: '#2F5BE4', flexDirection: 'row', justifyContent: 'flex-end', alignItems: 'center', padding: '0px 4px' }}>
                    <Box style={{ width: 22, height: 22, borderRadius: 11, background: '#F7F5F0' }} />
                </Box>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2F5BE4' }}>开</Text>
            </Box>
        </Box>

        {/* B 内容区：双栏 */}
        <Box style={{ height: 470, flexDirection: 'row', gap: 34 }}>

            {/* 左：仓库 */}
            <Box style={{ width: 500, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10, marginBottom: 12 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: 'rgba(247,245,240,0.75)' }}>仓库</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,245,240,0.35)' }}>客户主页 + 账号读出 · 已省流</Text>
                </Box>

                <Box style={{ background: 'rgba(247,245,240,0.06)', border: '1px solid rgba(247,245,240,0.10)', borderRadius: 10, padding: '13px 16px', marginBottom: 10 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.4 }}>我们把单体拆成微服务，两年后的复盘</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(247,245,240,0.42)', marginTop: 5 }}>支持 · 微服务　｜　微服务 vs 单体</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,245,240,0.62)', marginTop: 7, lineHeight: 1.5 }}>拆出七个服务后可独立发布、新人上手更快，作者结论是值得。</Text>
                </Box>

                <Box style={{ background: 'rgba(247,245,240,0.06)', border: '1px solid rgba(247,245,240,0.10)', borderRadius: 10, padding: '13px 16px', marginBottom: 10 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.4 }}>坚持 TDD 三年，我的真实体会</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(247,245,240,0.42)', marginTop: 5 }}>支持 · 先写测试　｜　测试驱动开发是否必要</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,245,240,0.62)', marginTop: 7, lineHeight: 1.5 }}>回归缺陷从每月四五个降到一年两三个，作者认为长期回本。</Text>
                </Box>

                <Box style={{ background: 'rgba(247,245,240,0.06)', border: '1px solid rgba(247,245,240,0.10)', borderRadius: 10, padding: '13px 16px' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.4 }}>为什么我们最终选了 React</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(247,245,240,0.42)', marginTop: 5 }}>支持 · React　｜　React vs Vue</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,245,240,0.62)', marginTop: 7, lineHeight: 1.5 }}>生态与招人成本最终压过了框架本身的手感差异。</Text>
                </Box>
            </Box>

            {/* 中：箭头 */}
            <Box style={{ width: 40, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 22, color: 'rgba(247,245,240,0.25)' }}>→</Text>
            </Box>

            {/* 右：反仓库 */}
            <Box style={{ width: 520, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10, marginBottom: 12 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#C2410C' }}>反仓库</Text>
                    <Text style={{ fontSize: 14, color: 'rgba(247,245,240,0.35)' }}>同议题、反立场、带原文出处</Text>
                </Box>

                <Box style={{ background: 'rgba(247,245,240,0.06)', borderLeft: '3px solid #C2410C', borderRadius: 10, padding: '12px 16px', marginBottom: 9 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.4 }}>从微服务走向单体化</Text>
                    <Text style={{ fontSize: 12.5, color: 'rgba(247,245,240,0.48)', marginTop: 4 }}>站 · 单体　｜　对立度 0.95　｜　v2ex.com</Text>
                    <Text style={{ fontSize: 13.5, color: 'rgba(247,245,240,0.58)', marginTop: 6, lineHeight: 1.5 }}>「CEO 觉得微服务部署极其繁琐……要求把十来个微服务合并成一个。」</Text>
                </Box>

                <Box style={{ background: 'rgba(247,245,240,0.06)', borderLeft: '3px solid #C2410C', borderRadius: 10, padding: '12px 16px', marginBottom: 9 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.4 }}>微服务的缺点</Text>
                    <Text style={{ fontSize: 12.5, color: 'rgba(247,245,240,0.48)', marginTop: 4 }}>站 · 单体　｜　对立度 0.95　｜　v2ex.com</Text>
                    <Text style={{ fontSize: 13.5, color: 'rgba(247,245,240,0.58)', marginTop: 6, lineHeight: 1.5 }}>「网络调用过多、运维成本高、易瘫痪」—— 与「高可用」叙事正面冲突。</Text>
                </Box>

                <Box style={{ background: 'rgba(247,245,240,0.06)', borderLeft: '3px solid #C2410C', borderRadius: 10, padding: '12px 16px' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#F7F5F0', lineHeight: 1.4 }}>经技术选型研究，我们放弃了 React，转向 Vue</Text>
                    <Text style={{ fontSize: 12.5, color: 'rgba(247,245,240,0.48)', marginTop: 4 }}>站 · Vue　｜　对立度 1.00　｜　v2ex.com</Text>
                    <Text style={{ fontSize: 13.5, color: 'rgba(247,245,240,0.58)', marginTop: 6, lineHeight: 1.5 }}>同一个选型问题，相反结论 —— 而且是作者亲历的项目复盘。</Text>
                </Box>
            </Box>
        </Box>

        {/* 底部说明 */}
        <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 58, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 15, color: 'rgba(247,245,240,0.55)' }}>
                反库物理独立存放，靠条目 id 与原条目对应 —— 不是「混在信息流里推点反对意见」
            </Text>
            <Text style={{ fontSize: 15, color: '#C2410C' }}>每条都能点回原文</Text>
        </Box>

        <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 20, flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 13, color: 'rgba(247,245,240,0.30)' }}>ANTIPODE · TECHATHON 2026</Text>
            <Text style={{ fontSize: 13, color: 'rgba(247,245,240,0.30)' }}>04 / 09</Text>
        </Box>
    </Box>
</Slide>
