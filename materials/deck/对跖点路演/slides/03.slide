<Slide style={{ width: 1280, height: 720, background: '#F7F5F0', padding: '0px' }}>
    <Box style={{ position: 'relative', width: 1280, height: 720, padding: '20px 60px' }}>

        <Box style={{ height: 100, flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: 13, letterSpacing: 3, color: '#2F5BE4', marginBottom: 8 }}>0 2 · 设 计 判 断</Text>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#14161A', lineHeight: 1.25 }}>
                「相反」不是一种东西，是三种
            </Text>
        </Box>

        <Box style={{ height: 540 }}>
            <Text style={{ fontSize: 19, color: 'rgba(20,22,26,0.55)', marginBottom: 26 }}>
                不先把它们分开，反仓库必然退化成「杠精池」。
            </Text>

            <Box style={{ flexDirection: 'row', gap: 20, height: 404, alignItems: 'stretch' }}>

                {/* A 类 */}
                <Box style={{ flex: 1, height: 404, background: '#FFFFFF', borderTop: '3px solid #2F5BE4', padding: '24px 26px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#2F5BE4', lineHeight: 1.0 }}>A</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#14161A', marginTop: 14 }}>观点对立</Text>
                    <Text style={{ fontSize: 18, color: 'rgba(20,22,26,0.55)', marginTop: 6, lineHeight: 1.5 }}>同议题、反立场</Text>
                    <Text style={{ fontSize: 19, color: '#14161A', marginTop: 20, lineHeight: 1.6 }}>
                        你信微服务<br />→ 找到「我们把微服务拆回单体」
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 16, borderTop: '1px solid rgba(20,22,26,0.10)' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2F5BE4' }}>本期已实现并跑通</Text>
                    </Box>
                </Box>

                {/* B 类 */}
                <Box style={{ flex: 1, height: 404, background: 'rgba(20,22,26,0.035)', borderTop: '3px solid rgba(20,22,26,0.18)', padding: '24px 26px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 56, fontWeight: 'bold', color: 'rgba(20,22,26,0.30)', lineHeight: 1.0 }}>B</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: 'rgba(20,22,26,0.72)', marginTop: 14 }}>反向证据</Text>
                    <Text style={{ fontSize: 18, color: 'rgba(20,22,26,0.45)', marginTop: 6, lineHeight: 1.5 }}>反驳你结论的具体事实</Text>
                    <Text style={{ fontSize: 19, color: 'rgba(20,22,26,0.62)', marginTop: 20, lineHeight: 1.6 }}>
                        你信「微服务＝高可用」<br />→ 找到「因微服务故障 12 小时」
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 16, borderTop: '1px solid rgba(20,22,26,0.10)' }}>
                        <Text style={{ fontSize: 15, color: 'rgba(20,22,26,0.40)' }}>数据模型已留位</Text>
                    </Box>
                </Box>

                {/* C 类 */}
                <Box style={{ flex: 1, height: 404, background: 'rgba(20,22,26,0.035)', borderTop: '3px solid rgba(20,22,26,0.18)', padding: '24px 26px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 56, fontWeight: 'bold', color: 'rgba(20,22,26,0.30)', lineHeight: 1.0 }}>C</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: 'rgba(20,22,26,0.72)', marginTop: 14 }}>视野缺失</Text>
                    <Text style={{ fontSize: 18, color: 'rgba(20,22,26,0.45)', marginTop: 6, lineHeight: 1.5 }}>你完全没覆盖的相邻议题</Text>
                    <Text style={{ fontSize: 19, color: 'rgba(20,22,26,0.62)', marginTop: 20, lineHeight: 1.6 }}>
                        你只看微服务<br />→ 提示 Serverless 这条路
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 16, borderTop: '1px solid rgba(20,22,26,0.10)' }}>
                        <Text style={{ fontSize: 15, color: 'rgba(20,22,26,0.40)' }}>数据模型已留位</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 20, flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 13, color: 'rgba(20,22,26,0.40)' }}>ANTIPODE · TECHATHON 2026</Text>
            <Text style={{ fontSize: 13, color: 'rgba(20,22,26,0.40)' }}>03 / 09</Text>
        </Box>
    </Box>
</Slide>
