# ============================================================
# 环境变量模板
# 把本文件复制一份, 重命名为 .env, 然后填入你的密钥
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# 注意: .env 里是真实密钥, 已被 .gitignore 忽略, 绝不要提交到 git
# ============================================================

# ============================================================
# 方案 A: 比赛方提供的 DeepSeek 网关 (需向现场工作人员确认接口地址)
# ============================================================
# ⚠️ 真实密钥属私密资源, 请填入本地 .env (已被 .gitignore 忽略), 不要写进本模板
OPENAI_API_KEY=比赛方现场提供的密钥
OPENAI_BASE_URL=请向现场工作人员确认后填写
STANCE_MODEL=deepseek-pro

# ============================================================
# 备选方案: 如果比赛方接口一时拿不到, 先用自备密钥, 不要阻塞开发
# 只需把上面三行注释掉, 改成下面任意一组
# ============================================================

# ---------- DeepSeek 官方 (需自己充值, key 以 sk- 开头) ----------
# OPENAI_API_KEY=sk-你的deepseek密钥
# OPENAI_BASE_URL=https://api.deepseek.com
# STANCE_MODEL=deepseek-flash

# ---------- 智谱 GLM (推荐: glm-4-flash-250414 官方免费档, 不计费) ----------
# 注意: 老的 glm-4-flash / glm-4.5-flash 已在官方下线或做了别名映射, 建议直接用下面这个明确标 free 的型号名
# OPENAI_API_KEY=你的智谱密钥
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# STANCE_MODEL=glm-4-flash-250414
# 备选免费型号: glm-4.7-flash (200K 上下文, 高峰期可能返回 1305 访问量过大)

# ---------- 阿里云百炼 (通义千问) ----------
# OPENAI_API_KEY=sk-你的百炼密钥
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STANCE_MODEL=qwen-plus

# ---------- OpenAI 官方 ----------
# OPENAI_API_KEY=sk-你的openai密钥
# OPENAI_BASE_URL=https://api.openai.com/v1
# STANCE_MODEL=gpt-4o-mini
